# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local

# vercel
.vercel

# serena
/.serena/

# local resume drafts
/docs/

# GSD planning docs (local only)
/.planning/

# typescript incremental build cache (regenerated by `yarn typecheck`)
/tsconfig.tsbuildinfo

.claude
# generated self-contained build of the palette tuner (760 KB); rebuild with
# `node design/palette-tuner/build.mjs --inline` when you need one file to share
design/palette-tuner/index.inline.html

# Font subsets: regenerated from assets/fonts/*.ttf by scripts/subset-font.ts on
# every predev/prebuild/pretest, and by an explicit step in deploy.yml before
# `next build`. The committed copies were never served -- they only produced a
# binary diff every time the Chinese copy changed.
public/fonts/*.woff2
